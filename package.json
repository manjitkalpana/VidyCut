    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "fflate": "^0.8.3",
    "helmet": "^8.1.0",
    "idb": "^8.0.3",
    "immer": "^10.1.1",
