# Local editing needs no environment variables, API key, account or database.
# Copy this file to .env only when configuring optional cloud services.

# PUBLIC, embedded into the Vite build. Never put a service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:8787/api

# SERVER ONLY. Use a dedicated Supabase/Postgres database.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
PORT=8787
ALLOWED_ORIGINS=http://localhost:4173
# Enable only behind exactly one trusted reverse proxy.
TRUST_PROXY=0
# Operational upload budget; coordinate with db/storage.sql and your reverse proxy.
MAX_UPLOAD_BYTES=268435456

# Optional OpenAI-compatible, self-hosted Whisper endpoint (including the path).
WHISPER_URL=
WHISPER_MODEL=whisper-1
WHISPER_API_KEY=

# Optional model adapter. Contract is documented in docs/API.md.
MODEL_PROVIDER_URL=
MODEL_PROVIDER_KEY=
